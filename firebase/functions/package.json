{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "node scripts/clean-build.cjs && tsc",
    "test": "npm run lint && npm run test:spare-parts && npm run test:machinery",
    "test:machinery": "npm run build && node test/machinery.test.cjs",
    "test:spare-parts": "npm run build && node test/spareParts.test.cjs",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "qs": "6.16.0",
    "ts-deepmerge": "8.0.0",
    "uuid": "11.1.1"
  },
  "private": true
}
