rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isLaundryServicesAdmin() {
      return isSignedIn()
        && request.auth.token.laundryServicesAdmin == true;
    }

    function isLaundryMachineImage() {
      return request.resource != null
        && request.resource.size <= 12 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /maquinaria/{machineId}/{fileName} {
      allow read: if true;
      allow create, update: if isLaundryServicesAdmin()
        && isLaundryMachineImage();
      allow delete: if isLaundryServicesAdmin();
    }

    match /laundry-submissions/{submissionId}/{fingerprint}/{index} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
